# greyscale print: black-to-grey cycle paired with linestyles, serif, white background
figure.facecolor: FFFFFF
axes.facecolor:   FFFFFF
savefig.facecolor: FFFFFF
text.color:       000000
axes.labelcolor:  000000
axes.edgecolor:   000000
xtick.color:      000000
ytick.color:      000000
grid.color:       D9D9D9
grid.linestyle:   -
grid.linewidth:   0.6
axes.prop_cycle:  cycler('color', ['000000', '595959', '8C8C8C', '000000', '595959', '8C8C8C']) + cycler('linestyle', ['-', '--', ':', '-.', '-', '--'])
image.cmap:       Greys
figure.figsize:   6, 3.5
figure.dpi:       110
savefig.dpi:      300
savefig.bbox:     tight
font.family:      serif
font.serif:       DejaVu Serif, Times New Roman, Times, serif
mathtext.fontset: dejavuserif
font.size:        10
axes.titlesize:   11
axes.spines.top:  False
axes.spines.right: False
legend.frameon:   False
lines.linewidth:  1.4
lines.markersize: 4
hatch.color:      000000
