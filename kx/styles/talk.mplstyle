# slides: 16:9, large sans type, thick lines, readable from the back of the room
figure.facecolor: FFFFFF
axes.facecolor:   FFFFFF
savefig.facecolor: FFFFFF
text.color:       1A1A1A
axes.labelcolor:  1A1A1A
xtick.color:      333333
ytick.color:      333333
axes.edgecolor:   555555
axes.linewidth:   1.5
grid.color:       E0E0E0
grid.linewidth:   1
axes.spines.top:  False
axes.spines.right: False
axes.prop_cycle:  cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9'])
figure.figsize:   10, 5.625
figure.dpi:       100
savefig.dpi:      200
savefig.bbox:     tight
font.family:      sans-serif
font.size:        18
axes.titlesize:   22
axes.titleweight: bold
axes.labelsize:   18
xtick.labelsize:  16
ytick.labelsize:  16
legend.fontsize:  16
legend.frameon:   False
xtick.major.size: 7
ytick.major.size: 7
xtick.major.width: 1.5
ytick.major.width: 1.5
lines.linewidth:  3
lines.markersize: 9
